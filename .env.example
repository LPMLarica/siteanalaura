# Variáveis para rodar localmente sem secrets.toml (copie para .env).
# Supabase → botão Connect → Connection String → Method: "Session pooler".
# Formato: postgresql://postgres.kzwwtywsvwhywlbzyidd:SENHA@aws-?-sa-east-1.pooler.supabase.com:5432/postgres
# Troque [YOUR-PASSWORD] pela senha do banco (Project Settings → Database).
DATABASE_URL=COLE-AQUI-A-URI-DO-SESSION-POOLER

# Supabase → Project Settings → API Keys (chave pública, pode ficar no código)
SUPABASE_URL=https://kzwwtywsvwhywlbzyidd.supabase.co
SUPABASE_KEY=sb_publishable_bruzqfRsLUAVQqP48QZoqg_255G4-HA

# Chave que criptografa os prontuários. Gere UMA vez e guarde uma cópia
# segura: se ela for perdida ou trocada, os prontuários ficam ilegíveis.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=COLE-AQUI-A-CHAVE-FERNET

# Opcionais
APP_NAME=Agenda Psicóloga Ana Laura
PROFESSIONAL_NAME=Ana Laura
TIMEZONE=America/Sao_Paulo

# Depois de criar a sua conta, troque para false para ninguém mais se cadastrar.
ALLOW_SIGNUP=true

# Opcional: só estes e-mails podem entrar/cadastrar (separados por vírgula).
# ALLOWED_EMAILS=analaura@exemplo.com

# Minutos sem uso até pedir login de novo.
SESSION_TIMEOUT_MINUTES=120
